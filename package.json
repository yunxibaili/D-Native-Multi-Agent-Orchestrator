{
  "name": "native-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-agent orchestrator that drives native coding-agent CLIs (OpenCode, Codex) over subprocess JSONL. No provider API calls.",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "orchestrator": "./src/cli/index.ts"
  },
  "scripts": {
    "doctor": "node src/cli/index.ts doctor",
    "decision:check": "node src/decision/check.ts",
    "decision:probe": "node src/decision/check.ts --probe",
    "oc": "node src/cli/index.ts run opencode",
    "cx": "node src/cli/index.ts run codex",
    "review": "node src/cli/index.ts review codex",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:state-loop": "node tests/state-loop.test.ts",
    "test:review-loop": "node tests/review-loop.test.ts",
    "test:attempt-record": "node tests/attempt-record.test.ts",
    "test:assignment": "node tests/assignment.test.ts",
    "test:planner": "node tests/planner.test.ts",
    "test:workbench": "node tests/workbench.test.ts",
    "test:spawn-gate-production": "node tests/spawn-gate-production.test.ts",
    "test:execution-monitor": "node tests/execution-monitor.test.ts",
    "e2e:native": "node tests/native-agent-e2e.test.ts",
    "test": "node scripts/test-timed.mjs",
    "test:unit": "node tests/unit.test.ts",
    "test:contract": "node tests/contract.test.ts",
    "test:decision": "node tests/decision.test.ts",
    "test:cancel": "node tests/cancel.test.ts",
    "test:workbuddy": "node tests/workbuddy.test.ts",
    "test:cline": "node tests/cline.test.ts",
    "test:quota": "node tests/quota.test.ts",
    "test:memory": "node tests/memory.test.ts",
    "test:model-pool": "node tests/model-pool.test.ts",
    "smoke": "node --import ./tests/helpers/offline-context.mjs src/cli/index.ts smoke",
    "smoke:quick": "node --import ./tests/helpers/offline-context.mjs src/cli/index.ts smoke --quick",
    "verify": "npm run typecheck && npm test",
    "test:resource-claim": "node tests/resource-claim.test.ts",
    "e2e:native:handoff": "node tests/native-handoff-e2e.test.ts",
    "test:round-result": "node tests/round-result.test.ts",
    "test:w41-natural-exit": "node tests/w41-opencode-natural-exit.test.ts",
    "test:w42-opencode": "node tests/w42-opencode-lifecycle.test.ts",
    "test:w42-codex": "node tests/w42-codex-lifecycle.test.ts",
    "test:w43-evidence": "node tests/w43-opencode-evidence.test.ts",
    "test:real-agent": "npm run test:w43-evidence && npm run test:w42-opencode",
    "test:w44-cleanup": "node tests/real-agent-cleanup.test.ts",
    "test:w51-evidence": "node tests/w51-real-descendant-isolation.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  }
}
